Задача 10 Написать программу, которая выводит названия всех пустых текстовых файлов в указанной директории. 
Директория передается в программу параметром.
cat << 'EOF' > find_empty_text.sh
#!/usr/bin/env bash
target_dir="${1:?Ошибка: укажите целевую директорию}"

if [[ ! -d "$target_dir" ]]; then
    echo "Ошибка: директория '$target_dir' не найдена!" >&2
    exit 1
fi

# Ищем пустые файлы (размером 0 байт)
find "$target_dir" -type f -empty | while IFS= read -r file; do
    mime_type=$(file --brief --mime-type "$file")             //--mime-type — возвращает MIME-тип в стандартизированном виде (например, text/plain, text/x-c, inode/x-empty)

    if [[ "$mime_type" == text/* || "$mime_type" == "inode/x-empty" || "$mime_type" == "application/x-empty" ]]; then    //проверяет пустой ли файл
        basename "$file"    //отсекает путь к файлу оставляет только название
    fi
done
EOF
chmod +x find_empty_text.sh


./find_empty_text.sh /path/to/directory




