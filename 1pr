cat << 'EOF' > find_duplicates
#!/usr/bin/env bash
dir="${1:-.}"
find "$dir" -type f -exec md5 -r {} + 2>/dev/null | sort | awk '
{
    hash = $1
    $1 = ""
    sub(/^ /, "")
    file = $0
    count[hash]++
    files[hash] = files[hash] "\n" file
}
END {
    for (h in count) {
        if (count[h] > 1) {
            print "Дубликаты (хэш " h "):" files[h] "\n"
        }
    }
}'
EOF
