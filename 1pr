Задача 6 Написать программу для проверки наличия комментария в первой строке файлов с расширением c, js и py.
cat << 'EOF' > check_comments.sh
#!/usr/bin/env bash

find . -type f \( -name "*.c" -o -name "*.js" -o -name "*.py" \) | while IFS= read -r file; do
//искать с текущего каталога и смотреть только файлы;поис по расширениям(-о это или);гарант сохранения пробелов в названии
    first_line=$(head -n 1 "$file")           //считывание и сохранение первой строчки файла

    case "$file" in
        *.c|*.js)
            if [[ "$first_line" =~ ^[[:space:]]*(\/\/|\/\*) ]]; then        //в строке допускается любое кол-во табуляций
                echo "[OK] $file: есть комментарий"                         //экранирования слэшей и *
            else
                echo "[NO] $file: комментария нет"
            fi
            ;;
        *.py)
            if [[ "$first_line" =~ ^[[:space:]]*# ]]; then
                echo "[OK] $file: есть комментарий"
            else
                echo "[NO] $file: комментария нет"
            fi
            ;;
    esac
done
EOF
chmod +x check_comments.sh

./check_comments.sh




