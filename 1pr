Задача 8 Написать программу, которая находит все файлы в данном каталоге с расширением, 
указанным в качестве аргумента и архивирует все эти файлы в архив tar.
cat << 'EOF' > archive_by_ext.sh
#!/usr/bin/env bash
ext="${1:?Ошибка: укажите расширение файлов (например: txt)}"            //извлекает первый аргумент в переменную, если не передано выдает ошибку
archive_name="archive_${ext}.tar"

ext="${ext#.}"                                         //удвление ведущей точки

find . -maxdepth 1 -type f -name "*.${ext}" -print0 | tar -cvf "$archive_name" --null -T -
//ищем только файлы в текущем каталоге;с заданым расширением; выводим имена файлов, разделяя их пустым байтом
//создвем tar без сжатия; создаем архив,добавляем названия по мере их появления,задаем имя; передаем что входной список разделен пустым байтом
//читаем из стандартного потока ввода stdin

echo "Файлы с расширением .${ext} успешно упакованы в $archive_name"
EOF
chmod +x archive_by_ext.sh

./archive_by_ext.sh txt


