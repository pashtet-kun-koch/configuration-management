Задача 3 Написать программу banner средствами bash для вывода текстов
cat << 'EOF' > banner        //что написано до слова EOF, передается на вход команде cat.
#!/usr/bin/env bash
text="$*"                   //помещает текст в переменную
len=${#text}               //считает кол-во символов в переменной
line="+$(printf '%*s' "$((len + 2))" '' | tr ' ' '-')+"       //генерируем строку из пробелов нужной длины, сначала их пробелов потом меняем их на тире

echo "$line"
echo "| $text |"           //вывод
echo "$line"
EOF
