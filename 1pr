Задача 7 Написать программу для нахождения файлов-дубликатов (имеющих 1 или более копий содержимого) по заданному пути (и подкаталогам).
target_dir="${1:-.}"                       //определяем рабочую папку

if command -v md5sum >/dev/null 2>&1; then                           //берем одну из 2 утилит
    hash_cmd="md5sum"
else
    hash_cmd="md5 -r"
fi

find "$target_dir" -type f -exec $hash_cmd {} + 2>/dev/null | \                    //запустить проверку пачку всех файлов
awk '{
    hash = $1                                //сохраняем хэш файла
    $1 = ""                                  
    sub(/^ /, "", $0)                        //удаляем хэш и срезаем пробел
    files[hash] = files[hash] ? files[hash] "\n  " $0 : $0           //проверка был ли такой хэш
    count[hash]++                            //счетчик массив хэшей
}
END {
    found = 0
    for (h in count) {
        if (count[h] > 1) {
            found = 1
            print "Дубликаты (хеш " h "):"
            print "  " files[h]
            print "----------------------------------------"
        }
    }
    if (!found) print "Дубликатов не найдено."
}'

