cat << 'EOF' > check_comment
#!/usr/bin/env bash
for file in "$@"; do
    case "$file" in
        *.c|*.js)
            first_line=$(head -n 1 "$file")
            if [[ "$first_line" =~ ^[[:space:]]*(\/\/|\/\*) ]]; then
                echo "$file: есть комментарий"
            fi
            ;;
        *.py)
            first_line=$(head -n 1 "$file")
            if [[ "$first_line" =~ ^[[:space:]]*# ]]; then
                echo "$file: есть комментарий"
            fi
            ;;
    esac
done
EOF
chmod +x check_comment


