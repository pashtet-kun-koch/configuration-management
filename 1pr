Задача 9 Написать программу, которая заменяет в файле последовательности из 4 пробелов на символ табуляции. 
Входной и выходной файлы задаются аргументами.
cat << 'EOF' > spaces_to_tabs.sh
#!/usr/bin/env bash
input="${1:?Ошибка: укажите входной файл}"
output="${2:?Ошибка: укажите выходной файл}"

if [[ ! -f "$input" ]]; then
    echo "Ошибка: входной файл '$input' не существует!" >&2
    exit 1
fi

sed $'s/    /\t/g' "$input" > "$output"
//sed - стандартный потоковый редактор; меняет 4 пробела на табуляцию(\t), деалет это во всем файле 

echo "Готово! Результат сохранен в $output"
EOF
chmod +x spaces_to_tabs.sh


./spaces_to_tabs.sh input.txt output.txt



